          ],
          "title": "Item Id"
        },
        "kind": {
          "enum": [
            "run",
            "journal"
          ],
          "title": "Kind",
          "type": "string"
        },
        "release_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Release Key"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "item_id",
        "release_key",
        "state"
      ],
      "title": "InFlightCancelled",
      "type": "object"
