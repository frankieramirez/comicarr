  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Mark one issue or annual Wanted (Comicarr searches for it) or Skipped (it stops).",
    "inputSchema": {
      "properties": {
        "issue_id": {
          "description": "Comicarr's issue or annual id.",
          "minLength": 1,
