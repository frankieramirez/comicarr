          "type": "boolean"
        },
        "entity_type": {
          "enum": [
            "issue",
            "annual"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "issue_id": {
          "title": "Issue Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "Wanted",
            "Skipped"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "entity_type",
        "status",
        "changed"
      ],
      "title": "IssueStatusChange",
      "type": "object"
    },
    "title": "Set issue status"
  }
