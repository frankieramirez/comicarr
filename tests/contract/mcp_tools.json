  {
    "annotations": {
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Act on needs-attention items by release_key: retry the download, search again, or stop wanting the issue. Only the actions an item offers apply to it.",
    "inputSchema": {
      "properties": {
        "action": {
          "description": "retry, search_again, or stop_wanting (the issue is no longer Wanted).",
          "enum": [
            "retry",
            "search_again",
            "stop_wanting"
          ],
          "title": "Action",
          "type": "string"
        },
        "release_keys": {
          "description": "Items' release keys.",
          "items": {
            "type": "string"
          },
          "maxItems": 25,
          "minItems": 1,
          "title": "Release Keys",
          "type": "array"
        }
      },
      "required": [
        "action",
        "release_keys"
      ],
      "title": "resolve_attentionArguments",
      "type": "object"
    },
    "name": "resolve_attention",
    "outputSchema": {
      "$defs": {
        "AttentionItemResult": {
          "properties": {
            "message": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Message"
            },
            "ok": {
              "title": "Ok",
              "type": "boolean"
            },
            "problem": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Why it was not resolved, when ok is false.",
              "title": "Problem"
            },
            "release_key": {
              "title": "Release Key",
              "type": "string"
            },
            "run_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The search run a retry or search_again started.",
              "title": "Run Id"
            }
          },
          "required": [
            "release_key",
            "ok",
            "problem",
            "message",
            "run_id"
          ],
          "title": "AttentionItemResult",
          "type": "object"
        }
      },
      "properties": {
        "action": {
          "enum": [
            "retry",
            "search_again",
            "stop_wanting"
          ],
          "title": "Action",
          "type": "string"
        },
        "failed": {
          "title": "Failed",
          "type": "integer"
        },
        "results": {
          "items": {
            "$ref": "#/$defs/AttentionItemResult"
          },
          "title": "Results",
          "type": "array"
        },
        "succeeded": {
          "title": "Succeeded",
          "type": "integer"
        }
      },
      "required": [
        "action",
        "succeeded",
        "failed",
        "results"
      ],
      "title": "AttentionResolution",
      "type": "object"
    },
    "title": "Resolve needs-attention items"
  },
