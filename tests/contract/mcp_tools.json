[
  {
    "annotations": {
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List the series in the library, filtered by name, kind and status.",
    "inputSchema": {
      "properties": {
        "kind": {
          "anyOf": [
            {
              "enum": [
                "comic",
                "manga",
                "magazine"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "comic (includes magazines), manga or magazine.",
          "title": "Kind"
        },
        "limit": {
          "default": 25,
          "description": "Page size, 1 to 100.",
          "maximum": 100,
          "minimum": 1,
          "title": "Limit",
          "type": "integer"
        },
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Part of the series name, any case.",
          "title": "Name"
        },
        "offset": {
          "default": 0,
          "description": "Items to skip before this page.",
          "minimum": 0,
          "title": "Offset",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "Active",
                "Paused",
                "Ended",
                "Loading",
                "Error"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Series status.",
          "title": "Status"
        }
      },
      "title": "list_seriesArguments",
      "type": "object"
    },
    "name": "list_series",
    "outputSchema": {
      "$defs": {
        "SeriesSummary": {
          "properties": {
            "have": {
              "description": "Issues on disk.",
              "title": "Have",
              "type": "integer"
            },
            "kind": {
              "enum": [
                "comic",
                "manga",
                "magazine"
              ],
              "title": "Kind",
              "type": "string"
            },
            "latest_issue": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Latest Issue"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "publisher": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Publisher"
            },
            "series_id": {
              "title": "Series Id",
              "type": "string"
            },
            "status": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            },
            "total": {
              "description": "Issues the series has.",
              "title": "Total",
              "type": "integer"
            },
            "year": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Year"
            }
          },
          "required": [
            "series_id",
            "name",
            "year",
            "publisher",
            "kind",
            "status",
            "have",
            "total",
            "latest_issue"
          ],
          "title": "SeriesSummary",
          "type": "object"
        }
      },
      "properties": {
        "next_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Offset of the next page; null on the last page.",
          "title": "Next Offset"
        },
        "series": {
          "items": {
            "$ref": "#/$defs/SeriesSummary"
          },
          "title": "Series",
          "type": "array"
        },
        "total": {
          "description": "Items matching the filters, across all pages.",
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "total",
        "next_offset",
        "series"
      ],
      "title": "SeriesPage",
      "type": "object"
    },
    "title": "List series"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Stop automatic searching for one series. Its issues keep their status.",
    "inputSchema": {
      "properties": {
        "series_id": {
          "description": "Comicarr's series id, from list_series.",
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        }
      },
      "required": [
        "series_id"
      ],
      "title": "pause_seriesArguments",
      "type": "object"
    },
    "name": "pause_series",
    "outputSchema": {
      "properties": {
        "changed": {
          "description": "False when the series already had this status.",
          "title": "Changed",
          "type": "boolean"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "Paused",
            "Active"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "status",
        "changed"
      ],
      "title": "SeriesStatusChange",
      "type": "object"
    },
    "title": "Pause series"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Restart automatic searching for a paused series.",
    "inputSchema": {
      "properties": {
        "series_id": {
          "description": "Comicarr's series id, from list_series.",
          "minLength": 1,
          "title": "Series Id",
          "type": "string"
        }
      },
      "required": [
        "series_id"
      ],
      "title": "resume_seriesArguments",
      "type": "object"
    },
    "name": "resume_series",
    "outputSchema": {
      "properties": {
        "changed": {
          "description": "False when the series already had this status.",
          "title": "Changed",
          "type": "boolean"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "Paused",
            "Active"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "series_id",
        "status",
        "changed"
      ],
      "title": "SeriesStatusChange",
      "type": "object"
    },
    "title": "Resume series"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Hand a search run's waiting items to a worker again, for a run that is still open but stuck before it started searching.",
    "inputSchema": {
      "properties": {
        "run_id": {
          "description": "A search run id, as a search tool returned it.",
          "minLength": 1,
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id"
      ],
      "title": "retry_search_runArguments",
      "type": "object"
    },
    "name": "retry_search_run",
    "outputSchema": {
      "properties": {
        "dispatched": {
          "description": "Search items handed to a worker by this retry.",
          "title": "Dispatched",
          "type": "integer"
        },
        "pending": {
          "description": "Items still waiting for a worker after this retry.",
          "title": "Pending",
          "type": "integer"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "dispatched",
        "pending"
      ],
      "title": "SearchRunRetry",
      "type": "object"
    },
    "title": "Retry a search run"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Search the providers for one Wanted issue now. Returns a run_id at once; the search runs in the background.",
    "inputSchema": {
      "properties": {
        "issue_id": {
          "description": "Comicarr's issue or annual id.",
          "minLength": 1,
          "title": "Issue Id",
          "type": "string"
        }
      },
      "required": [
        "issue_id"
      ],
      "title": "search_issueArguments",
      "type": "object"
    },
    "name": "search_issue",
    "outputSchema": {
      "properties": {
        "accepted": {
          "description": "Wanted issues the run will search.",
          "title": "Accepted",
          "type": "integer"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Poll this run for progress. Null when nothing was eligible.",
          "title": "Run Id"
        },
        "series_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Series Id"
        },
        "status": {
          "description": "pending_dispatch: recorded, and Comicarr hands it to a worker as soon as it can.",
          "enum": [
            "accepted",
            "pending_dispatch",
            "noop"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "series_id",
        "accepted",
        "status"
      ],
      "title": "SearchStarted",
      "type": "object"
    },
    "title": "Search for an issue"
  },
  {
